// Friends (v2, docs/application/features/v2-friends-requirements.md): add a friend by their QR
// code and see their pet. Written only by the /api/app/v1/friends routes, through Prisma, always
// for the verified caller. Not expressible here, and kept by the migrations: RLS on both tables
// with no policies and nothing granted to the API roles.

// The code a person shows to be added (R7): 8 characters from @app/contract's alphabet, made by
// the server from a cryptographic random source, created the first time it is asked for. A new
// code replaces the row's code, so the old one stops working at once (R6). Nothing derived from
// the user id. Deleted with the account.
model FriendCode {
  userId    String   @id @map("user_id") @db.Uuid
  code      String   @unique @db.VarChar(8)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  profile   Profile  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("friend_codes")
}

// One row per pair of friends (R22), mutual: the pair is stored in id order (`user_low` <
// `user_high`, checked by the store), so a pair has exactly one row whoever added whom. Removing
// it ends the friendship for both (R12). Deleted when either account is.
model Friendship {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userLow   String   @map("user_low") @db.Uuid
  userHigh  String   @map("user_high") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  low       Profile  @relation("friendshipLow", fields: [userLow], references: [id], onDelete: Cascade, onUpdate: NoAction)
  high      Profile  @relation("friendshipHigh", fields: [userHigh], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userLow, userHigh])
  @@index([userHigh])
  @@map("friendships")
}
