// Long-term memory (v2, docs/application/features/v2-memory-requirements.md): short facts about
// the person that the pet keeps and brings back. Never what was said: the model writes each fact
// in the third person ("Has an exam on Friday"), and the server checks it (@app/contract,
// src/v1/memory.ts) before keeping it. Nothing sensitive, nothing from someone under 13.
//
// Up to 30 facts per pet, 100 with Plus; at most 6 reach the model with a message, picked by a
// score in plain code (R9). `category`, `kind` and `source` are text, not enums: their lists live
// in @app/contract, so a new one ships without a migration. `tags` are the words someone might
// use for the fact, for the score. An event has `follow_up_on` (the local day after which the
// pet asks about it), the question to ask (`follow_up`) and, once asked, `followed_up_at`; it is
// deleted 14 days after its day. `last_used_at` is when it last went into a prompt.
//
// Written only by the server (the talk route, the intro, the memory routes), always scoped to the
// verified caller's pet. Deleted with the pet, so with the account. Not expressible here, and
// kept by the migrations: RLS on with no policies and nothing granted to the API roles.
model PetMemory {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  petId        String    @map("pet_id") @db.Uuid
  text         String    @db.VarChar(80)
  followUp     String?   @map("follow_up") @db.VarChar(80)
  category     String
  kind         String
  importance   Int       @db.SmallInt
  tags         String[]
  followUpOn   DateTime? @map("follow_up_on") @db.Date
  followedUpAt DateTime? @map("followed_up_at") @db.Timestamptz(6)
  source       String
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  pet          Pet       @relation(fields: [petId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([petId])
  @@map("pet_memories")
}

// "Tell me about you" (v2-memory-requirements.md, R21–R24): one row per model call that answered,
// keyed by the message id the phone made, so a retry finds its row and never calls the model
// again, and "at most 2" is a count of rows. A call that failed writes none (decision 7). Never
// what was said or the pet's line: only how many facts the call kept. The step's end is
// `pets.intro_finished_at`. Written only by the intro route, deleted with the pet. Not
// expressible here, and kept by the migrations: RLS on with no policies and nothing granted to
// the API roles.
model PetIntroAttempt {
  /// The phone's message id.
  id         String   @id @db.Uuid
  petId      String   @map("pet_id") @db.Uuid
  factsSaved Int      @map("facts_saved") @db.SmallInt
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  pet        Pet      @relation(fields: [petId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([petId])
  @@map("pet_intro_attempts")
}
